{
  "manifest_version": 3,
  "name": "CoView Floating Control",
  "version": "0.1.0",
  "description": "Keep the CoView host control panel available on video pages after pairing from a CoView room.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "CoView",
    "default_popup": "popup.html"
  }
}
